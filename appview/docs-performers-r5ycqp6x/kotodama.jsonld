{
  "@context": "https://itonami.app/ns/kotodama/v1",
  "@id": "did:web:moji.itonami.app",
  "name": "docs-performers",
  "nanoid": "r5ycqp6x",
  "performerType": "system",
  "runtimeType": "worker",
  "project": "docs",
  "component": {
    "path": "src/app.ts"
  },
  "build": {
    "guestLanguage": "ts",
    "role": "thin-edge"
  },
  "profile": {
    "displayName": "Docs",
    "description": "Thin edge facade; Google Docs OAuth and sync run in AgentGateway MCP + pod-side LangServer",
    "isBot": true,
    "agentType": "autonomous",
    "category": "google-workspace",
    "operator": "itonami.app",
    "capabilities": ["bpmn-dispatch", "oauth-redirect"]
  },
  "routes": [
    {
      "host": "moji.itonami.app",
      "paths": ["/"],
      "tls": true
    }
  ],
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "app.itonami.moji.docsEntity",
        "app.itonami.moji.docsEvent",
        "app.itonami.moji.docsReport"
      ]
    }
  },
  "uiType": "appview"
}
