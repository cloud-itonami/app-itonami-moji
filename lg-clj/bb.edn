;; Scoped babashka project for the lg-docs clj/bb port (ADR-2606280030,
;; langgraph-python -> langgraph-clj). Independent of the repo-root bb.edn.
;;
;;   src   — lg-docs.* namespaces (port of lg/lg_docs/**)
;;   tests — clojure.test ports of lg/tests/**
;;
;; langgraph-clj is pinned to the same sha as the repo-root bb.edn so the actor
;; StateGraph idiom is identical to kaname/yobel. cheshire + babashka.http-client
;; are bb built-ins.
{:paths ["src" "tests"]
 :deps {
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "af1a7179b7de6f29f6b816ecdbd2e98e6165d203"
         :deps/root "lib/kotoba.bytes"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "af1a7179b7de6f29f6b816ecdbd2e98e6165d203"
         :deps/root "lib/kotoba.edn"}
       com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/com-junkawasaki/langgraph-clj"
         :git/sha "c7daa07d4e50f55d7e2a02e4b89dbeb2b200961d"}
        com-junkawasaki/langchain-clj
        {:git/url "https://github.com/com-junkawasaki/langchain-clj"
         :git/sha "2b03859c3ee722b64f3eddd0b615a54019b17c81"}}
 :tasks
 {test
  {:doc "Run the lg-docs clojure.test suite (port parity with lg/tests/**)."
   :task (load-file "run_tests.clj")}}}
